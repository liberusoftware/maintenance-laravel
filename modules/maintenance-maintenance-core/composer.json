{
  "name": "liberusoftware/module-maintenance-maintenance-core",
  "description": "Maintenance organizations, service settings, statuses, priorities, numbering, and shared events.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/auth": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-manager": "^1.0",
    "liberusoftware/organizations-teams": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Maintenance\\Core\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "maintenance-maintenance-core"
    }
  },
  "version": "0.1.0",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Modules\\Maintenance\\Core\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
