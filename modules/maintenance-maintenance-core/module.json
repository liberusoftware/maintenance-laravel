{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "maintenance-maintenance-core",
  "display_name": "Maintenance Core",
  "description": "Organizations, service settings, statuses, priorities, numbering, and shared events.",
  "version": "0.1.0",
  "category": "capability",
  "provider": "Liberu\\Modules\\Maintenance\\Core\\MaintenanceCoreServiceProvider",
