{
  "name": "liberusoftware/module-maintenance-portals-filament",
  "description": "Portal filament adapter for Liberu Maintenance",
  "type": "liberu-module",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "require": {
    "php": "^8.5",
    "filament/filament": "~5.1",
    "liberusoftware/module-maintenance-portals": "0.1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Maintenance\\Portals\\Filament\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "module-maintenance-portals-filament",
      "provider": "Liberu\\Modules\\Maintenance\\Portals\\Filament\\PortalsFilamentServiceProvider"
    }
  },
  "support": {
    "source": "https://github.com/liberusoftware/module-maintenance-portals-filament/tree/main",
    "issues": "https://github.com/liberusoftware/module-maintenance-portals-filament/issues"
  }
}
