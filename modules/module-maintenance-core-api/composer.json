{
  "name": "liberusoftware/module-maintenance-core-api",
  "description": "HTTP API adapter for Maintenance Core.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-maintenance-maintenance-core": "0.1.0",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Maintenance\\Core\\Api\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-maintenance-core-api"
    }
  },
  "version": "0.1.0",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
