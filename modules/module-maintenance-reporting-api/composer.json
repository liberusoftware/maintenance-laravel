{
  "name": "liberusoftware/module-maintenance-reporting-api",
  "description": "Report api adapter for Liberu Maintenance",
  "type": "liberu-module",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "liberusoftware/module-maintenance-reporting": "0.1.0",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Maintenance\\Reporting\\Api\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "module-maintenance-reporting-api",
      "provider": "Liberu\\Modules\\Maintenance\\Reporting\\Api\\ReportingApiServiceProvider"
    }
  },
  "support": {
    "source": "https://github.com/liberusoftware/module-maintenance-reporting-api/tree/main",
    "issues": "https://github.com/liberusoftware/module-maintenance-reporting-api/issues"
  }
}
