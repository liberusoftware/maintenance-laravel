{
  "name": "liberusoftware/module-maintenance-commercial",
  "description": "Commercial domain module for Liberu Maintenance",
  "type": "liberu-module",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-manager": "^1.0",
    "liberusoftware/organizations-teams": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Maintenance\\Commercial\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "module-maintenance-commercial",
      "provider": "Liberu\\Modules\\Maintenance\\Commercial\\CommercialServiceProvider"
    }
  },
  "support": {
    "source": "https://github.com/liberusoftware/module-maintenance-commercial/tree/main",
    "issues": "https://github.com/liberusoftware/module-maintenance-commercial/issues"
  }
}
