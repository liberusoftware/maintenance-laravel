{
  "name": "liberusoftware/module-maintenance-portals-livewire",
  "description": "Portal livewire adapter for Liberu Maintenance",
  "type": "liberu-module",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "require": {
    "php": "^8.5",
    "livewire/livewire": "^4.0",
    "liberusoftware/module-maintenance-portals": "0.1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Maintenance\\Portals\\Livewire\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "module-maintenance-portals-livewire",
      "provider": "Liberu\\Modules\\Maintenance\\Portals\\Livewire\\PortalsLivewireServiceProvider"
    }
  },
  "support": {
    "source": "https://github.com/liberusoftware/module-maintenance-portals-livewire/tree/main",
    "issues": "https://github.com/liberusoftware/module-maintenance-portals-livewire/issues"
  }
}
